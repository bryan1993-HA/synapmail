# ─── Auth ─────────────────────────────────────────────────────
NEXTAUTH_URL=https://mail.yourdomain.com
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Database ─────────────────────────────────────────────────
# With Docker Compose: hostname is "postgres" (the service name)
# With external PostgreSQL: replace "postgres" with your host/IP
# Must match POSTGRES_PASSWORD below
DATABASE_URL=postgresql://synapmail_user:changeme@postgres:5432/synapmail

# ─── Encryption (for email passwords stored in DB) ────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-string-here

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://mail.yourdomain.com

# Allow new user registration (set to false after initial setup)
REGISTRATION_ENABLED=true

# ─── PostgreSQL container ─────────────────────────────────────
# Used by the postgres service in docker-compose.yml
POSTGRES_PASSWORD=changeme
